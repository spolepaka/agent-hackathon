{
  "name": "learnloop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "start:win": "set NODE_ENV=production&& tsx server/index.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.2.6",
    "@fontsource/manrope": "5.2.6",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "lucide-react": "0.536.0",
    "motion": "12.23.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.0",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.1.3"
  }
}
